{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex fix architecture result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "finding_fingerprints",
    "root_cause",
    "violated_invariant",
    "failing_paths",
    "affected_seams",
    "repair_strategy",
    "required_behaviors",
    "prohibited_partial_fixes",
    "regression_tests",
    "verification",
    "risks",
    "blockers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "finding_fingerprints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "root_cause": {
      "type": "string"
    },
    "violated_invariant": {
      "type": "string"
    },
    "failing_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failingPath"
      }
    },
    "affected_seams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repair_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_behaviors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_partial_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/regressionTest"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationItem"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "failingPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "symbol",
        "behavior"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "behavior": {
          "type": "string"
        }
      }
    },
    "regressionTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "proves"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "proves": {
          "type": "string"
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        }
      }
    }
  }
}