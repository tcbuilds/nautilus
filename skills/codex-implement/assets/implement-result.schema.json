{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex implementation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "deviations"],
  "properties": {
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "files_changed", "verification", "blockers"],
          "properties": {
            "status": { "type": "string", "enum": ["complete"] },
            "files_changed": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "verification": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/verificationItem" }
            },
            "blockers": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "files_changed", "verification", "blockers"],
          "properties": {
            "status": { "type": "string", "enum": ["no_change_needed"] },
            "files_changed": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string" }
            },
            "verification": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/verificationItem" }
            },
            "blockers": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "files_changed", "verification", "blockers"],
          "properties": {
            "status": { "type": "string", "enum": ["blocked", "failed"] },
            "files_changed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "verification": {
              "type": "array",
              "items": { "$ref": "#/$defs/verificationItem" }
            },
            "blockers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "deviations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    }
  }
}
